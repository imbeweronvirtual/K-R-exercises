    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Prog",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/vboxuser/Desktop/projects_book/K-R-exercises/CS50-and-additional-exercises/subtitution/subtitution",  // enter program name, for example ${workspaceFolder}/a.out
            "args": ["ABCDEFGHIJKLMNOPQRSTUVWXYZ"],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}